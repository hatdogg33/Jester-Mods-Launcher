# Bind this service behind a TLS reverse proxy in any non-local deployment.
HOST=127.0.0.1
PORT=8787
DATA_DIR=./data

# A long random value. It protects every /admin endpoint.
ADMIN_TOKEN=replace-with-a-long-random-secret

# Development mode accepts launcher proof requests after validating their shape.
# Set false only after you implement server-side Android Keystore proof/attestation validation.
DEVELOPMENT_MODE=true

# Generated by `npm run keys`; do not commit either private key.
UPDATE_SIGNING_PRIVATE_KEY=./keys/update-private.pem
LEASE_SIGNING_PRIVATE_KEY=./keys/lease-private.pem
