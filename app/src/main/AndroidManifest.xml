<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Required for the launcher’s remote release and module download channel. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Android still shows its own confirmation before replacing the launcher. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Soul Knight's non-root patch replaces the Play-signed package after explicit confirmation. -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />

    <!-- Module manifests can target arbitrary games, so a static package query list cannot
         describe the launcher's sideloaded package-discovery use case. -->
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <uses-permission
        android:name="android.permission.SYSTEM_ALERT_WINDOW"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.SYSTEM_OVERLAY_WINDOW"
        tools:node="remove" />

    <uses-permission android:name="android.permission.SEND_SMS" tools:node="remove" />
    <uses-permission android:name="android.permission.RECEIVE_MMS" tools:node="remove" />
    <uses-permission android:name="android.permission.RECEIVE_SMS" tools:node="remove" />
    <uses-permission android:name="android.permission.READ_SMS" tools:node="remove" />
    <uses-permission android:name="android.permission.WRITE_SMS" tools:node="remove" />
    <uses-permission android:name="android.permission.BROADCAST_WAP_PUSH" tools:node="remove" />
    <uses-permission android:name="android.permission.BROADCAST_SMS" tools:node="remove" />
    <uses-permission android:name="android.permission.SEND_RESPOND_VIA_MESSAGE" tools:node="remove" />
    <uses-permission android:name="android.provider.Telephony.SMS_RECEIVED" tools:node="remove" />
    <uses-permission android:name="android.permission.CALL_PHONE" tools:node="remove" />
    <uses-permission android:name="android.permission.PROCESS_OUTGOING_CALLS" tools:node="remove" />
    <uses-permission android:name="android.permission.READ_CALL_LOG" tools:node="remove" />
    <uses-permission android:name="android.permission.WRITE_CALL_LOG" tools:node="remove" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" tools:node="remove" />
    <uses-permission android:name="android.permission.READ_PHONE_NUMBERS" tools:node="remove" />
    <uses-permission android:name="android.permission.READ_PRECISE_PHONE_STATE" tools:node="remove" />
    <uses-permission android:name="android.permission.READ_CONTACTS" tools:node="remove" />
    <uses-permission android:name="android.permission.WRITE_CONTACTS" tools:node="remove" />
    <uses-permission android:name="com.google.android.gms.permission.READ_CALL_LOG" tools:node="remove" />
    <uses-permission android:name="com.google.android.gms.permission.WRITE_CALL_LOG" tools:node="remove" />
    <uses-permission android:name="com.google.android.gms.permission.READ_PHONE_STATE" tools:node="remove" />
    <uses-permission android:name="com.google.android.gms.permission.READ_PHONE_NUMBERS" tools:node="remove" />
    <uses-permission android:name="com.google.android.gms.permission.READ_PRECISE_PHONE_STATE" tools:node="remove" />
    <uses-permission android:name="com.google.android.gms.permission.FOREGROUND_SERVICE_PHONE_CALL" tools:node="remove" />
    <uses-permission android:name="com.google.android.gms.permission.READ_CONTACTS" tools:node="remove" />
    <uses-permission android:name="com.google.android.gms.permission.WRITE_CONTACTS" tools:node="remove" />

    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- Lets the access gate identify a real external browser instead of accidentally
             pinning an HTTPS request to Android's resolver activity. -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
    </queries>

    <application
        android:name=".HubApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:resizeableActivity="true"
        android:supportsRtl="true"
        android:theme="@style/Theme.JesterMoods">

        <provider
            android:name=".identity.IdentityPayloadProvider"
            android:authorities="${applicationId}.identity-payload"
            android:exported="true"
            android:grantUriPermissions="false" />

        <provider
            android:name=".DiagnosticExportProvider"
            android:authorities="${applicationId}.diagnostics"
            android:exported="true"
            android:grantUriPermissions="false" />

        <service
            android:name=".LauncherTaskLifecycleService"
            android:exported="false"
            android:stopWithTask="false" />

        <activity
            android:name=".FacebookCallbackActivity"
            android:exported="false"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- Exposes only verified launcher-update and original-game APKs to Android's installer. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.launcher-updates"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/launcher_update_paths" />
        </provider>

        <receiver
            android:name=".networking.GameInstallReceiver"
            android:exported="false" />

        <receiver
            android:name=".PackageReplacementInstallReceiver"
            android:exported="false" />

        <activity
            android:name=".LauncherActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:screenOrientation="portrait">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Generic module/deep-link handoff. Expected query fields are validated in code. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="mymenu" android:host="download" />
            </intent-filter>

            <!-- Website release-update callback emitted by the supplied Worker. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="moodtools-update" android:host="resume" />
            </intent-filter>

            <!-- Device-bound launcher digital-key callback. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="moodtools-launcher" android:host="unlock" />
            </intent-filter>

            <!-- HTTPS fallback for links opened from the Cloudflare website. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="https"
                    android:host="voidmod1.uncledrew697.workers.dev"
                    android:pathPrefix="/mod-update-release" />
            </intent-filter>
        </activity>
    </application>
</manifest>
